{
  "name": "goss-upload",
  "version": "1.0.0",
  "description": "Uploads each site's compiled CSS from GOSS-skin/global/sites to GOSS iCM Media.",
  "main": "upload-css.js",
  "private": true,
  "scripts": {
    "start": "node upload-css.js",
    "upload": "node upload-css.js",
    "upload:all": "node upload-css.js all",
    "upload:dev": "node upload-css.js --env dev",
    "upload:tst": "node upload-css.js --env tst",
    "upload:prp": "node upload-css.js --env prp",
    "upload:prd": "node upload-css.js --env prd",
    "check": "node --check upload-css.js",
    "build-exe": "node build-exe.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "ISC",
  "devDependencies": {
    "playwright": "^1.64.1",
    "postject": "^1.0.0-alpha.6"
  }
}