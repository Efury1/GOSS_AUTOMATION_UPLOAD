# Settings for upload-css.js (your own copy: not committed to git).
# Anything you remove or comment out with # uses the built-in default.
# Do not put passwords here: you log in yourself in Edge.

# Where the built CSS lives: one folder per site, each with <site>.css inside.
# A full path, or relative to the goss-upload folder.
SITES_DIR=../GOSS-skin/Where-site-files-sit

# iCM login page for each environment
ICM_DEV_URL=
ICM_TST_URL=
ICM_PRP_URL=
ICM_PRD_URL=

# Which browser to drive: msedge, or chrome
BROWSER=msedge

# true = upload the first site only and save screenshots, for testing changes
LEARN_MODE=false